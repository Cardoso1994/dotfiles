{
  "version": "v1",
  "hooks": [
    {
      "name": "ruff-format",
      "description": "Format .py files with ruff after writes and edits.",
      "trigger": "PostToolUse",
      "matcher": "^(fs_write|fs_append|str_replace)$",
      "action": {
        "type": "command",
        "command": "\"$HOME/dotfiles/claude/hooks/ruff-format.sh\""
      }
    },
    {
      "name": "md-line-length",
      "description": "Report .md/.txt lines over 80 chars after writes and edits.",
      "trigger": "PostToolUse",
      "matcher": "^(fs_write|fs_append|str_replace)$",
      "action": {
        "type": "command",
        "command": "\"$HOME/dotfiles/claude/hooks/md-line-length.sh\""
      }
    }
  ]
}
