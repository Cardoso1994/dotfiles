{
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true
  },
  "theme": "auto",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ruff-format.sh",
            "statusMessage": "Formatting Python file with ruff..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/md-line-length.sh",
            "statusMessage": "Checking markdown/text line length..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(kiro-worker *)"]
  },
  "cleanupPeriodDays": 365,
  "editorMode": "vim",
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "model": "sonnet"
}
