{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Transcript",
      "bindings": {
        "ctrl+u": "scroll:halfPageUp",
        "ctrl+f": "scroll:halfPageDown",
        "alt+j": "scroll:lineDown",
        "alt+k": "scroll:lineUp"
      }
    },
    {
      "context": "Scroll",
      "bindings": {
        "ctrl+u": "scroll:halfPageUp",
        "ctrl+f": "scroll:halfPageDown",
        "alt+j": "scroll:lineDown",
        "alt+k": "scroll:lineUp"
      }
    },
    {
      "context": "Pane",
      "bindings": {
        "escape": null,
        "ctrl+x tab": "abovePrompt:leave"
      }
    },
    {
      "context": "AbovePromptInput",
      "bindings": {
        "escape": null,
        "ctrl+x tab": "abovePrompt:leave"
      }
    },
    {
      "context": "AbovePromptSelect",
      "bindings": {
        "escape": null,
        "ctrl+x tab": "abovePrompt:leave"
      }
    },
    {
      "context": "AbovePrompt",
      "bindings": {
        "escape": null,
        "ctrl+x tab": "abovePrompt:leave"
      }
    },
    {
      "context": "PaneField",
      "bindings": {
        "escape": null,
        "ctrl+x tab": "abovePrompt:leave"
      }
    }
  ]
}
